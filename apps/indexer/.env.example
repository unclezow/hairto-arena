# NEAR indexer. Copy to apps/indexer/.env; every value below is a placeholder or a default.

NEAR_NETWORK=testnet
NODE_ENV=development

# Postgres of the backend: the indexer writes only to its own schema, which indexer-sync reads.
DATABASE_URL=postgresql://hairto:hairto@localhost:5434/hairto
INDEXER_SCHEMA=chain
# Holds the single-instance lock (key indexer:lock).
REDIS_URL=redis://localhost:6379

# First block to index: the arena's deployment block. Required while deployments/<network>.json has no startBlock.
INDEXER_START_BLOCK=

# Neardata (final blocks). The free tier allows 180 requests per minute per IP; stay under it.
NEARDATA_URL=https://testnet.neardata.xyz
NEARDATA_MAX_RPM=150
# Optional FastNEAR key, sent to Neardata and the Transactions API. Leave empty for the free tier.
NEARDATA_API_KEY=

# Gap-fill after an outage: reads only blocks with our transactions, found through the Transactions API.
TX_API_URL=https://tx.test.fastnear.com
GAP_FILL_THRESHOLD=300
GAP_FILL_SAFETY=120

# Development only, refused in production: jump to the head once, skipping everything in between for good.
INDEXER_RESET_TO_HEAD=false
INDEXER_WAIT_MS=1000
