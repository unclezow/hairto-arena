  },
  "dependencies": {
    "@hairto-arena/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@hairto-arena/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
