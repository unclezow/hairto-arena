NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# Origin allowed by CORS and the WebSocket gateway
WEB_ORIGIN=http://localhost:3000
# Reverse proxy hops in front of the API (0 = none). Needed so rate limits see the client address.
TRUST_PROXY=0

# docker-compose.yml (host port 5434)
DATABASE_URL=postgresql://hairto:hairto@localhost:5434/hairto
REDIS_URL=redis://localhost:6379

# NEAR network. Contract and service account ids default to deployments/testnet.json; override them here.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# ARENA_ID=arena.hairto.testnet
# VAULT_ID=vault.hairto.testnet
# USDC_ID=usdc.hairto.testnet
# CHARACTERS_ID=characters.hairto.testnet

# Service keys (docs: runbook section 5 and 6). Secret: share privately, never commit, never paste into logs.
# Format: ed25519:<base58 secret key>. Only ONE worker may run with these keys at a time: gas-key nonces are
# cached per process.
# Price pusher: gas key limited to arena.push_ticks.
PUSHER_ACCOUNT_ID=pusher.hairto.testnet
PUSHER_GAS_KEY=
PUSHER_GAS_KEY_LANES=8
# Keeper: function-call key on the arena, plus a second one on the vault (defaults to the arena key).
KEEPER_ACCOUNT_ID=keeper.hairto.testnet
KEEPER_KEY=
KEEPER_VAULT_KEY=
# Bots: one account per level (arena.set_bot), each with a gas key limited to open_position, close_position and
# reveal_bot_seed. A level without a gas key is not served.
BOT_LV1_ACCOUNT_ID=rookie.bots.hairto.testnet
BOT_LV2_ACCOUNT_ID=trend.bots.hairto.testnet
BOT_LV3_ACCOUNT_ID=reversion.bots.hairto.testnet
BOT_LV4_ACCOUNT_ID=oracle.bots.hairto.testnet
BOT_LV1_GAS_KEY=
BOT_LV2_GAS_KEY=
BOT_LV3_GAS_KEY=
BOT_LV4_GAS_KEY=
BOT_GAS_KEY_LANES=8
# Signs seed tickets only; its public key must equal arena.bot_service_key. It is no account's key.
BOT_SERVICE_TICKET_KEY=

# Price source:
# hyperliquid (free, no key) | pyth (Hermes, needs PYTH_API_KEY) | mock (random walk)
PRICE_SOURCE=hyperliquid
# Optional per-market sources, preferred first (falls back when stale), e.g.
# PRICE_SOURCES=GOOGL=hyperliquid;BTC=pyth,hyperliquid;XAU=pyth,hyperliquid
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# Wallet auth (NEP-413). ADMIN_ACCOUNTS is a comma separated allowlist of NEAR account ids.
ADMIN_ACCOUNTS=hairto.testnet
# App id: the NEP-413 recipient of the sign-in challenge.
AUTH_DOMAIN=localhost
NONCE_TTL_SEC=600
SESSION_TTL_SEC=43200

# Rate limits (requests per window, per session address or IP)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_READ_PER_WINDOW=120
RATE_LIMIT_WRITE_PER_WINDOW=30
RATE_LIMIT_AUTH_PER_WINDOW=20

# Readiness fails when the indexer sync lags more than this many blocks
INDEXER_MAX_LAG_BLOCKS=50

# Indexer -> API sync (worker process)
INDEXER_SCHEMA=chain
SYNC_ENABLED=true
SYNC_INTERVAL_MS=2000
SYNC_BATCH_SIZE=500
SYNC_REPLAY_WINDOW_BLOCKS=10

# Price pusher (worker process)
PRICE_PUSHER_ENABLED=true
PRICE_PUSH_INTERVAL_MS=1000
PRICE_LOCK_TTL_MS=5000
# Gas of one push_ticks transaction in Tgas: base + per asset
PRICE_TX_TGAS_BASE=30
PRICE_TX_TGAS_PER_ASSET=5
PRICE_DEMAND_TTL_SEC=30
PRICE_PRIME_TIMEOUT_MS=5000
HERMES_POLL_MS=500
HERMES_STREAM_RETRY_MS=5000
# PRICE_SOURCE=mock only: seeded random walk
MOCK_SEED=5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e
MOCK_BASE_PRICE=100
MOCK_VOLATILITY_BPS=2

# Bot service (worker process)
BOT_ENABLED=true
# Secret, shared privately: must be the same key that encrypted existing bot seeds, or they cannot be revealed.
# A brand-new setup can generate one with: openssl rand -hex 32
BOT_SEED_ENCRYPTION_KEY=
BOT_REVEAL_TIMEOUT_SEC=600
BOT_REVEAL_INTERVAL_MS=5000

# Duels (API and worker)
DUELS_ENABLED=true
DUEL_BOT_TIMEOUT_MS=20000
DUEL_SETTLE_INTERVAL_MS=3000
DUEL_SETTLE_GRACE_SEC=5
DUEL_STUCK_AFTER_SEC=300
# Damage preview model; must match the arena's active damage configuration. The contract decides the real result.
DAMAGE_STRATEGY=asset-scaled

# Realtime gateway (API) and chain event publisher (worker)
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_ROOMS_PER_SOCKET=10
WS_MAX_MESSAGE_BYTES=16384
WS_TICK_MIN_INTERVAL_MS=500
REALTIME_EVENTS_ENABLED=true
REALTIME_EVENTS_INTERVAL_MS=1000

# Season page estimates and the Backer pool split reading; keep the split in step with the vault
ESTIMATE_APY_BPS=500
VAULT_B_SPLIT_MODE=afterFee

# Keeper (worker). It sends transactions that move money, so it is off until you turn it on.
KEEPER_ENABLED=false
KEEPER_DRY_RUN=false
KEEPER_SEASON_INTERVAL_MS=30000
KEEPER_HARVEST_INTERVAL_MS=3600000
KEEPER_MIN_HARVEST_UNITS=1000000
KEEPER_TWAB_TOLERANCE_BPS=1
KEEPER_MAX_INDEXER_LAG_BLOCKS=10
KEEPER_ROLLOVER_DAYS=30

# Admin and anti-abuse
RATE_LIMIT_DUEL_PER_WINDOW=10
RATE_LIMIT_ADMIN_PER_WINDOW=30
ADMIN_FRESH_SIGNATURE_SEC=900
ABUSE_ENABLED=true
# Flags are written but fighters are not marked. Turn off only after the thresholds were tuned on real play.
ABUSE_REPORT_ONLY=true
ABUSE_INTERVAL_MS=300000
ABUSE_MIN_DUELS=20
ABUSE_LV1_SHARE=0.8
ABUSE_LV1_WINRATE=0.95
ABUSE_CAP_DAYS=3
ABUSE_INTERVAL_CV=0.1
ABUSE_BASELINE_WINRATE=0.55
ABUSE_WINRATE_Z=4
ABUSE_CYCLE_COUNT=3
ABUSE_CYCLE_WINDOW_SEC=3600
