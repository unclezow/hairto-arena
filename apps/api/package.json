{
  "name": "@hairto-arena/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm run --parallel \"/^dev:(api|worker)$/\"",
    "dev:api": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker --path tsconfig.worker.json",
    "debug": "nest start --debug --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "sync:rebuild": "node dist/indexer-sync/rebuild.js",
    "sync:repair-bots": "node dist/indexer-sync/repair-bots.js",
    "db:seed": "node dist/price/seed.js",
    "season:verify": "node dist/keeper/verify-cli.js"
  },
  "dependencies": {
    "@hairto-arena/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "borsh": "^2.0.0",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "near-kit": "^0.20.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hairto-arena/config": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "socket.io-client": "4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
